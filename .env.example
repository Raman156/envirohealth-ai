# Application
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://envirohealth:envirohealth@localhost:5432/envirohealth_db
SYNC_DATABASE_URL=postgresql://envirohealth:envirohealth@localhost:5432/envirohealth_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# External APIs
WEATHER_API_KEY=your_openweathermap_api_key
AIR_QUALITY_API_KEY=your_iqair_or_openaq_api_key
WATER_QUALITY_API_KEY=your_water_quality_api_key
MAP_API_KEY=your_mapbox_api_key

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_HEALTH_REPORTS=10/minute

# Background Jobs (intervals in seconds)
FETCH_ENV_DATA_INTERVAL=600
UPDATE_RISK_SCORES_INTERVAL=900
CALCULATE_TRENDS_INTERVAL=3600
CHECK_SENSOR_STATUS_INTERVAL=300
